---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
		<a href="#inicio" class="text-xl font-bold tracking-tight">Astrorante</a>
		<nav aria-label={t("nav.main")} class="hidden md:block">
			<ul class="flex items-center gap-8 text-sm font-medium">
				<li><a href="#inicio" class="hover:underline hover:underline-offset-4">{t("nav.home")}</a></li>
				<li><a href="#nosotros" class="hover:underline hover:underline-offset-4">{t("nav.about")}</a></li>
				<li><a href="#carta" class="hover:underline hover:underline-offset-4">{t("nav.menu")}</a></li>
				<li>
					<a
						href="#visitanos"
						class="rounded-full bg-neutral-900 px-4 py-2 text-white hover:bg-neutral-700"
					>
						{t("nav.reserve")}
					</a>
				</li>
				<li>
					<LanguageSwitcher lang={lang} />
				</li>
			</ul>
		</nav>
	</div>
	<nav aria-label={t("nav.mobile")} class="border-t border-neutral-100 md:hidden">
		<ul class="mx-auto flex max-w-6xl items-center justify-center gap-6 px-4 py-3 text-sm font-medium">
			<li><a href="#inicio" class="hover:underline hover:underline-offset-4">{t("nav.home")}</a></li>
			<li><a href="#nosotros" class="hover:underline hover:underline-offset-4">{t("nav.about")}</a></li>
			<li><a href="#carta" class="hover:underline hover:underline-offset-4">{t("nav.menu")}</a></li>
			<li>
				<LanguageSwitcher lang={lang} />
			</li>
		</ul>
	</nav>
</header>

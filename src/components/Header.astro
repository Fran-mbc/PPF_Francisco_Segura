---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl min-w-0 flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6 lg:px-8">
		<a
			href="#inicio"
			class="inline-flex min-h-[44px] items-center rounded text-xl font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-900"
		>
			Astrorante
		</a>
		<nav aria-label={t("nav.main")} class="hidden min-w-0 md:block">
			<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium lg:gap-8">
				<li><a href="#inicio" class="inline-flex min-h-[44px] items-center rounded hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.home")}</a></li>
				<li><a href="#nosotros" class="inline-flex min-h-[44px] items-center rounded hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.about")}</a></li>
				<li><a href="#carta" class="inline-flex min-h-[44px] items-center rounded hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.menu")}</a></li>
				<li>
					<a
						href="#visitanos"
						class="inline-flex min-h-[44px] items-center rounded-full bg-neutral-900 px-5 py-2.5 text-white hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
					>
						{t("nav.reserve")}
					</a>
				</li>
				<li>
					<div role="group" aria-label={t("langPicker.label")}>
						<LanguageSwitcher lang={lang} />
					</div>
				</li>
			</ul>
		</nav>
		<div role="group" aria-label={t("langPicker.label")} class="md:hidden">
			<LanguageSwitcher lang={lang} />
		</div>
	</div>
	<nav aria-label={t("nav.mobile")} class="border-t border-neutral-100 md:hidden">
		<ul class="mx-auto flex max-w-6xl min-w-0 flex-wrap items-center justify-center gap-x-4 gap-y-1 px-4 py-1 text-[13px] font-medium sm:px-6 sm:text-sm">
			<li><a href="#inicio" class="inline-flex min-h-[44px] items-center rounded px-1 hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.home")}</a></li>
			<li><a href="#nosotros" class="inline-flex min-h-[44px] items-center rounded px-1 hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.about")}</a></li>
			<li><a href="#carta" class="inline-flex min-h-[44px] items-center rounded px-1 hover:underline hover:underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900">{t("nav.menu")}</a></li>
			<li>
				<a
					href="#visitanos"
					class="inline-flex min-h-[44px] items-center rounded-full bg-neutral-900 px-4 py-2 text-white hover:bg-neutral-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
				>
					{t("nav.reserve")}
				</a>
			</li>
		</ul>
	</nav>
</header>

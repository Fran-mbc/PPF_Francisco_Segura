---
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = ["#carta", "#nosotros", "#visitanos"];
const iconShapes = [
  "rounded-full bg-neutral-900",
  "rounded-lg bg-neutral-700",
  "rounded-full bg-neutral-900 ring-4 ring-neutral-200",
];

const cards = [0, 1, 2].map((i) => ({
  title: t(`docs.items.${i}.title`),
  description: t(`docs.items.${i}.description`),
  href: links[i],
  iconClass: iconShapes[i],
}));
---

<section id="noticias" aria-labelledby="docs-title" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <p class="text-xs font-bold tracking-widest text-neutral-500 uppercase">
      {t("docs.eyebrow")}
    </p>
    <h2 id="docs-title" class="mt-2 text-3xl font-bold tracking-tight text-neutral-900">
      {t("docs.title")}
    </h2>
    <p class="mt-3 max-w-2xl text-base text-neutral-600">
      {t("docs.subtitle")}
    </p>
    <ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <li>
          <article class="h-full rounded-xl border border-neutral-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-neutral-900 hover:shadow-lg">
            <span aria-hidden="true" class={`block h-10 w-10 ${card.iconClass}`} />
            <h3 class="mt-4 text-lg font-semibold text-neutral-900">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600">{card.description}</p>
            <p class="mt-4">
              <a
                href={card.href}
                class="text-sm font-semibold text-neutral-900 underline-offset-4 hover:underline"
              >
                {t("docs.linkLabel")}
              </a>
            </p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

---
import Placeholder from "./ui/Placeholder.astro";

const deals = [
	{ name: "Tapas For Two", detail: "25% of tapas for two, every Sunday", price: "$750", image: "Tapas Dish" },
	{ name: "Mojito Monday", detail: "Every Monday from 5pm to 7pm", price: "$400", image: "Mojito Cocktail" },
	{ name: "Margarita Thursday", detail: "Every Thursday from 5pm to 7pm", price: "$350", image: "Classic Margarita" },
];
---

<section id="promos" aria-labelledby="deals-title">
	<div class="mx-auto max-w-6xl px-4 py-12">
		<h2 id="deals-title">Tasty deals</h2>
		<p>You can show your happy hour deals here</p>
		<ul class="grid gap-8 md:grid-cols-3">
			{deals.map((deal) => (
				<li>
					<article>
						<Placeholder label={deal.image} aspect="vertical" />
						<h3>{deal.name}</h3>
						<p>{deal.detail}</p>
						<p>{deal.price}</p>
					</article>
				</li>
			))}
		</ul>
	</div>
</section>

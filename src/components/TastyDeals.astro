---
import Placeholder from "./ui/Placeholder.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const offers = [0, 1, 2].map((i) => ({
  title: t(`deals.items.${i}.title`),
  description: t(`deals.items.${i}.description`),
  price: t(`deals.items.${i}.price`),
}));
---

<section id="promos" aria-labelledby="deals-title" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <p class="text-xs font-bold tracking-widest text-neutral-500 uppercase">
      {t("deals.eyebrow")}
    </p>
    <h2 id="deals-title" class="mt-2 text-3xl font-bold tracking-tight text-neutral-900">
      {t("deals.title")}
    </h2>
    <p class="mt-3 max-w-2xl text-base text-neutral-600">
      {t("deals.subtitle")}
    </p>
    <ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
      {offers.map((offer) => (
        <li>
          <article class="flex h-full flex-col rounded-xl border border-neutral-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-neutral-900">
            <Placeholder label={offer.title} aspect="video" />
            <h3 class="mt-4 text-lg font-semibold text-neutral-900">{offer.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-600">{offer.description}</p>
            <p class="mt-4">
              <span class="inline-block rounded-full bg-neutral-900 px-4 py-1.5 text-xl font-extrabold tracking-tight text-white">
                {offer.price}
              </span>
            </p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

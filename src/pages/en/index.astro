import OpenSource from "../../components/OpenSource.astro";
import TastyDeals from "../../components/TastyDeals.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
	lang="en"
	title="Restaurant — Landing page"
	description="Responsive restaurant landing page built with Astro and Tailwind CSS 4 as an educational exercise."
>
	<Header lang="en" />
	<main>
		<Hero lang="en" />
		<FlexibleMenu />
